{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/gutenberg/:path*",
      "destination": "https://www.gutenberg.org/:path*"
    },
    {
      "source": "/wsexport/:path*",
      "destination": "/api/wsexport"
    },
    {
      "source": "/wsexport",
      "destination": "/api/wsexport"
    }
  ]
}
